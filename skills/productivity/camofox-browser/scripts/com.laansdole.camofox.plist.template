<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.laansdole.camofox</string>
  <key>ProgramArguments</key><array><string>__HOME__/.camofox/run.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ExitTimeOut</key><integer>30</integer>
  <key>StandardOutPath</key><string>__HOME__/.camofox/server.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.camofox/server.log</string>
</dict></plist>
